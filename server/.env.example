# Copie este arquivo para ".env" e ajuste os valores.
PORT=3333

# Segredo usado para assinar os tokens JWT. Troque por um texto longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=2h

# Caminho do arquivo do banco SQLite (criado automaticamente)
DB_PATH=./data/petfacil.db

# Conta de administrador criada automaticamente na primeira execução
ADMIN_CPF=11144477735
ADMIN_NOME=Administrador PetFácil
ADMIN_LOGIN=admin@petfacil.com
ADMIN_SENHA=Admin@123

# OPCIONAL: se preencher, o assistente usa a API da Anthropic (Claude).
# Se deixar vazio, o assistente usa respostas por regras com dados do banco.
ANTHROPIC_API_KEY=
